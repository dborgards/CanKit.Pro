<Project>

  <!--
    eng/Dependencies.props (the CanKit version) is imported by Directory.Packages.props, which is
    where package versions belong. Importing it here as well would import the same file twice into
    every project (MSB4011).
  -->

  <PropertyGroup Label="Repository layout">
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <RepoArtifactsDir>$(RepositoryRoot)artifacts/</RepoArtifactsDir>
    <PackageOutputPath>$(RepoArtifactsDir)nuget/</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup Label="Language">
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!--
      CS1591 (missing XML comment) is reported per member; the public API is documented, but we do
      not want an incidental internal helper to break the build. `dotnet build -warnaserror` in a
      local sweep is the way to tighten this later.
    -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Versioning">
    <!--
      Nothing in the build computes a version. The build only ever *receives* one:

        * release  -> semantic-release passes -p:Version=X.Y.Z, the number it derived from the
                      conventional commits;
        * CI       -> the pipeline's `version` job runs GitVersion once and passes the SemVer it
                      derived from tags and branch history to every other job;
        * anything else (a plain `dotnet build`, an IDE, a source archive) -> VersionPrefix below.

      GitVersion deliberately does not run as an MSBuild task. It would run once per project and
      target framework, needs git history the build has no business requiring, and — as this
      repository found out on its first CI run — turns "I cannot determine a version" into a hard
      build failure. Versioning is a pipeline concern; compiling is not.

      To see the version GitVersion would give your working copy:  dotnet tool restore
                                                                   dotnet gitversion
    -->
    <VersionPrefix>0.0.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup Label="Package identity">
    <Authors>Dietmar Borgards</Authors>
    <Company>Dietmar Borgards</Company>
    <Product>CanKit.Pro</Product>
    <Copyright>Copyright (c) 2026 Dietmar Borgards</Copyright>
    <PackageProjectUrl>https://github.com/dborgards/CanKit.Pro</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dborgards/CanKit.Pro</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <PropertyGroup Label="Reproducible builds">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == '' AND '$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
