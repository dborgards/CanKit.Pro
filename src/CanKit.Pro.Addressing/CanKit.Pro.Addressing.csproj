<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>CAN-ID addressing helpers for CanKit (CanKit.Pro): validated 11-bit/29-bit ID construction, J1939 PGN/Priority/PDU-Format/Source-Address composition and decomposition, and ID-range/mask filter overlap detection — pure, dependency-free helper functions any protocol layer (ISO-TP, J1939, CANopen, ...) can build on instead of hand-rolled bit math scattered across endpoint types.</Description>
    <PackageTags>$(PackageTags);J1939;PGN;addressing</PackageTags>
  </PropertyGroup>

</Project>
