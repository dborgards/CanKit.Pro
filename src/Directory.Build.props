<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="Shipping libraries">
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>CAN;can-bus;CANFD;CanKit;CanKit.Pro;automotive;embedded</PackageTags>
  </PropertyGroup>

  <PropertyGroup Label="Package validation">
    <!--
      Every pack compares the public surface of each package with the last release on nuget.org
      (#257). Since 1.3.0 a breaking change costs a major version, and the API approval tests
      cannot tell additive from breaking; ApiCompat can, per target framework, and fails the pack
      on the pull request that introduces the break. The baseline is the last published version:
      semantic-release moves it right after every NuGet push (eng/set-package-validation-baseline.py,
      chained behind the push in the exec plugin's publishCmd, so it only ever names packages
      nuget.org has), and nothing has to be kept in step by hand.

      CP0003 compares assembly versions and is silenced only for a pack whose version is 0.0.0:
      a local `dotnet pack` given none (VersionPrefix in the root Directory.Build.props), and the
      CI version job's `0.0.0-unversioned.<run>` fallback for a ref GitVersion could not name,
      which exists to keep the build running and must not be failed by the baseline comparison
      instead (Bugbot on #281). Every real version, CI's `1.x.y-pr.<n>` and the release's own,
      is at or above the baseline and keeps the check.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.3.0</PackageValidationBaselineVersion>
    <NoWarn Condition="'$(Version)' == '' Or $(Version.StartsWith('0.0.0'))">$(NoWarn);CP0003</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="Per-package README shipped inside the .nupkg">
    <None Include="README.md" Pack="true" PackagePath="" Condition="Exists('README.md')" />
  </ItemGroup>

</Project>
