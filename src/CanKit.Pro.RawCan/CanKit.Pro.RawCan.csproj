<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Raw-CAN service layer for CanKit (CanKit.Pro): multi-protocol demultiplexing / subscriptions that give each protocol instance an independent, filtered read-only view of one ICanBus without competing over ReceiveAsync, plus a uniform TX-confirm abstraction over hardware echo.</Description>
    <PackageTags>$(PackageTags);demux;subscription;tx-confirm</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CanKit.Abstractions" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Threading.Channels" />
  </ItemGroup>

</Project>
